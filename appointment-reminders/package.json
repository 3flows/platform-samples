{
  "name": "appointment-reminders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Step-by-step appointment reminder sample for the 3flows Platform",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npm run build && node --test --test-concurrency=1 dist/steps/*/*.test.js",
    "step:00": "npm run build && node dist/steps/00-hello-world/main.js",
    "step:01": "npm run build && node dist/steps/01-book-appointment/main.js",
    "step:02": "npm run build && node dist/steps/02-store-appointments/main.js",
    "step:03": "npm run build && node dist/steps/03-sms-confirmation/main.js",
    "step:04": "npm run build && node dist/steps/04-reminder-timer/main.js",
    "step:05": "npm run build && node dist/steps/05-remember-reminders/main.js",
    "step:06": "npm run build && node dist/steps/06-async-with-queues/main.js",
    "step:07": "npm run build && node dist/steps/07-notifications-service/main.js",
    "step:08:notifications": "npm run build && node dist/steps/08-separate-processes/notifications-main.js",
    "step:08:appointments": "node dist/steps/08-separate-processes/appointments-main.js"
  },
  "dependencies": {
    "@3flows/platform": "file:../../platform"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
